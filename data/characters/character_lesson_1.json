    "part2_build": {
      "title": "Build",
      "subtitle": "Two basic writing rules",
      "intro": "Stroke order is not decoration — it is the rule that makes characters look right. Two rules cover this whole lesson.",
      "rules": [
        {
          "rule": "先横后竖",
          "rule_pinyin": "xiān héng hòu shù",
          "rule_en": "Horizontal before vertical",
          "audio_text": "先横后竖",
          "choices": [
            "横",
            "竖"
          ],
          "correct": "横",
          "result_char": "十",
          "result_pinyin": "shí",
          "result_meaning": "ten",
          "stroke_order": [
            "横",
            "竖"
          ],
          "explanation": "Write the 横 across, then the 竖 down through it. That gives you 十."
        },
        {
          "rule": "先撇后捺",
          "rule_pinyin": "xiān piě hòu nà",
          "rule_en": "Left-falling before right-falling",
          "audio_text": "先撇后捺",
          "choices": [
            "撇",
            "捺"
          ],
          "correct": "撇",
          "result_char": "人",
          "result_pinyin": "rén",
          "result_meaning": "person",
          "stroke_order": [
            "撇",
            "捺"
          ],
          "explanation": "The 撇 leans left first, then the 捺 spreads right to meet it. That gives you 人."
        }
      ]
    },
