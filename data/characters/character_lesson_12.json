        "title": "相生 · The generative cycle",
        "intro": "Follow the ring. Each element gives rise to the one after it.",
        "picture": "l12-p5-cycle",
        "steps": [
          {
            "from": "木",
            "to": "火",
            "text": "Wood feeds fire.",
            "audio_text": "木生火",
            "pinyin": "mù shēng huǒ"
          },
          {
            "from": "火",
            "to": "土",
            "text": "Fire leaves ash, and ash is earth.",
            "audio_text": "火生土",
            "pinyin": "huǒ shēng tǔ"
          },
          {
            "from": "土",
            "to": "金",
            "text": "Earth yields metal.",
            "audio_text": "土生金",
            "pinyin": "tǔ shēng jīn"
          },
          {
            "from": "金",
            "to": "水",
            "text": "Metal is associated with water.",
            "audio_text": "金生水",
            "pinyin": "jīn shēng shuǐ"
          },
          {
            "from": "水",
            "to": "木",
            "text": "Water nourishes wood.",
            "audio_text": "水生木",
            "pinyin": "shuǐ shēng mù"
          }
        ]
