    "part5_culture": {
      "title": "Discover Chinese",
      "subtitle": "汉字探秘 · Culture and language insights",
      "topic": "心里有什么？",
      "topic_en": "What's inside the heart?",
      "picture": "l14-p5-xin",
      "listen": {
        "intro": "The heart, and the two shapes it takes. Tap each to hear it.",
        "items": [
          {
            "character": "心",
            "pinyin": "xīn",
            "meaning": "heart",
            "audio_text": "心"
          },
          {
            "character": "情",
            "pinyin": "qíng",
            "meaning": "feeling",
            "audio_text": "情"
          },
          {
            "character": "心情",
            "pinyin": "xīnqíng",
            "meaning": "mood",
            "audio_text": "心情"
          }
        ]
      },
      "notice": "In Chinese the heart is not only where feeling lives — it is where thinking lives too. A character carrying 心 or 忄 may be about an emotion, or about a thought.",
      "discover": "That is why 想 means \"to think\" and not \"to love\": the heart underneath it is doing the thinking. Four-character sayings called 成语 chéngyǔ lean on this constantly — the heart stands in for the whole inner life.",
      "idioms": {
        "title": "成语 · Four characters, one idea",
        "intro": "Two sayings built on 心. Tap either to hear it.",
        "items": [
          {
            "idiom": "心想事成",
            "pinyin": "xīn xiǎng shì chéng",
            "audio_text": "心想事成",
            "literal": "heart thinks — matter becomes",
            "meaning": "May your wishes come true",
            "illustration": "l14-p5-xinxiangshicheng-art",
            "chars": [
              {
                "character": "心",
                "pinyin": "xīn",
                "meaning": "heart"
              },
              {
                "character": "想",
                "pinyin": "xiǎng",
                "meaning": "to think"
              },
              {
                "character": "事",
                "pinyin": "shì",
                "meaning": "matter"
              },
              {
                "character": "成",
                "pinyin": "chéng",
                "meaning": "to become"
              }
            ],
            "note": "A New Year greeting you will see on red envelopes and doorways. 想 is 心 sitting underneath — the heart doing the thinking.",
            "example": {
              "text": "祝你心想事成！",
              "pinyin": "Zhù nǐ xīn xiǎng shì chéng!",
              "meaning": "Wishing you all your wishes come true!"
            }
          },
          {
            "idiom": "口是心非",
            "pinyin": "kǒu shì xīn fēi",
            "audio_text": "口是心非",
            "literal": "mouth yes — heart no",
            "meaning": "Saying one thing while thinking another",
            "illustration": "l14-p5-koushixinfei-art",
            "chars": [
              {
                "character": "口",
                "pinyin": "kǒu",
                "meaning": "mouth"
              },
              {
                "character": "是",
                "pinyin": "shì",
                "meaning": "yes / is"
              },
              {
                "character": "心",
                "pinyin": "xīn",
                "meaning": "heart"
              },
              {
                "character": "非",
                "pinyin": "fēi",
                "meaning": "no / not"
              }
            ],
            "note": "The mouth agrees and the heart disagrees. Not quite lying — more the polite \"yes\" you give when you mean no.",
            "example": {
              "text": "他说他很好，可是他口是心非。",
              "pinyin": "Tā shuō tā hěn hǎo, kěshì tā kǒu shì xīn fēi.",
              "meaning": "He says he is fine, but he does not mean it."
            }
          }
        ]
      },
      "try": {
        "intro": "Which saying fits?",
        "items": [
          {
            "sentence": "她说「好」，心里想「不好」。",
