        {
          "radical": "阝",
          "name": "左耳旁",
          "pinyin": "zuǒ ěr páng",
          "name_en": "the left 阝, from 阜 — a hill",
          "audio_text": "左耳旁",
          "from": {
            "character": "阜",
            "pinyin": "fù",
            "meaning": "a mound / hill"
          },
          "hint": "On the LEFT this is 阜 worn down — a slope, a hillside, high ground.",
          "characters": [
            {
              "character": "阳",
              "pinyin": "yáng",
              "meaning": "sun / yang",
              "audio_text": "阳"
            },
            {
              "character": "阴",
              "pinyin": "yīn",
              "meaning": "shade / yin",
              "audio_text": "阴"
            }
          ],
          "find": {
            "question": "Which part of 阳 is the radical?",
            "choices": [
              "阝",
              "日",
              "⻊",
              "彳"
            ],
            "correct": "阝"
          },
          "reveal": {
            "category": "sunlight on a hillside",
            "note": "阳 is the lit side of the hill and 阴 the shaded one. That is where yang and yin come from."
          }
        },
        {
          "radical": "阝",
          "name": "右耳旁",
          "pinyin": "yòu ěr páng",
          "name_en": "the right 阝, from 邑 — a town",
          "audio_text": "右耳旁",
          "from": {
            "character": "邑",
            "pinyin": "yì",
            "meaning": "a walled town"
          },
          "hint": "The same shape on the RIGHT is a different character altogether: 邑, a walled town.",
          "characters": [
            {
              "character": "都",
              "pinyin": "dōu",
              "meaning": "all",
              "audio_text": "都"
            }
          ],
          "find": {
            "question": "阝 means two different things. What decides which?",
            "choices": [
              "which side it stands on",
              "its size",
              "the stroke order",
              "nothing — it is always the same"
