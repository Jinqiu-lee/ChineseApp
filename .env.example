# Copy this file to .env and fill in your own key.
# Get a key at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Cloud Text-to-Speech API, Cloud Speech-to-Text API
EXPO_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here
# Get from RevenueCat dashboard → Project Settings → API Keys → Public app-specific key
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_public_key_here
